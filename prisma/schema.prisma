generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LegalConfig {
  id         String    @id @default(uuid())
  validFrom  DateTime
  validTo    DateTime?
  configData String

  @@map("legal_configs")
}

model Employee {
  id               String            @id @default(uuid())
  document         String            @unique
  name             String
  position         String
  hireDate         DateTime
  terminationDate  DateTime?
  contractType     String
  baseSalary       Float
  isIntegralSalary Boolean           @default(false)
  arlRiskClass     String
  bankName         String?
  bankAccount      String?
  isActive         Boolean           @default(true)
  finalLiquidation FinalLiquidation?
  payrollRecords   PayrollRecord[]

  @@map("employees")
}

model PayrollPeriod {
  id             String          @id @default(uuid())
  startDate      DateTime
  endDate        DateTime
  isQuincenal    Boolean
  status         String          @default("draft")
  auditRecord    AuditRecord?
  payrollRecords PayrollRecord[]

  @@map("payroll_periods")
}

model PayrollRecord {
  id               String        @id @default(uuid())
  employeeId       String
  periodId         String
  daysWorked       Int
  novedades        String
  totalDevengado   Float
  totalDeducciones Float
  netPay           Float
  employerCost     Float
  calculations     String
  employee         Employee      @relation(fields: [employeeId], references: [id])
  period           PayrollPeriod @relation(fields: [periodId], references: [id])

  @@map("payroll_records")
}

model FinalLiquidation {
  id              String   @id @default(uuid())
  employeeId      String   @unique
  terminationDate DateTime
  reason          String
  baseSalary      Float
  totalSeverance  Float
  totalInterests  Float
  totalPremium    Float
  totalVacations  Float
  totalIndemnity  Float
  netPay          Float
  calculations    String
  employee        Employee @relation(fields: [employeeId], references: [id])

  @@map("final_liquidations")
}

model AuditRecord {
  id                    String        @id @default(uuid())
  periodId              String        @unique
  reportedTotalNet      Float
  reportedTotalSocial   Float
  calculatedTotalNet    Float
  calculatedTotalSocial Float
  differences           String
  status                String
  period                PayrollPeriod @relation(fields: [periodId], references: [id])

  @@map("audit_records")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}


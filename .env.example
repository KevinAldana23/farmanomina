# ======================
# CONFIGURACIÓN DE BASE DE DATOS
# ======================
# URL de conexión a tu base de datos PostgreSQL en Neon.tech
# Formato: postgres://usuario:contraseña@id.region.aws.neon.tech/nombre-db?sslmode=require
  DATABASE_URL="postgres://TU_USUARIO:TU_CONTRASEÑA@TU_ID.region.aws.neon.tech/TU_BASE_DE_DATOS?sslmod  e=require"

# ======================
# CONFIGURACIÓN DE AUTENTICACIÓN (NextAuth.js)
# ======================
# Secreto para firmar tokens JWT y cookies de sesión
# GENERA UNO SEGURO CON: openssl rand -base64 32
  NEXTAUTH_SECRET="TU_SECRETO_SUPER_SEGURO_AQUI"

# URL de tu aplicación (en desarrollo será localhost)
# En producción, Vercel/Netlify sobrescribirá esto automáticamente
  NEXTAUTH_URL="http://localhost:3000"